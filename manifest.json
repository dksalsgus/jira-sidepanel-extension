{
  "manifest_version": 3,
  "name": "Please Be Done for Jira: My Issues",
  "version": "1.1.1",
  "description": "See assigned Jira Cloud issues and current sprint work in Chrome's side panel without switching tabs.",
  "minimum_chrome_version": "114",

  "permissions": [
    "storage",
    "sidePanel"
  ],

  "host_permissions": [
    "https://*.atlassian.net/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["shared/design-tokens.css", "content/content.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_title": "Please Be Done for Jira: My Issues",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
